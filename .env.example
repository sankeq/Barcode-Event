# Contoh konfigurasi lingkungan untuk Aplikasi Barcode Peserta Event.
# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya bila perlu.
# JANGAN commit berkas `.env` berisi kredensial sungguhan.

# --- Database MySQL (dipakai mysql2/promise) ---
# Default cocok untuk XAMPP di komputer lokal (MySQL/MariaDB di 127.0.0.1:3306,
# user root tanpa kata sandi). Aplikasi membuat database + tabel otomatis saat
# pertama start, jadi cukup pastikan MySQL hidup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=event_barcode

# Alternatif: satu URL koneksi. Bila DATABASE_URL diisi, nilainya menang atas
# variabel DB_* individual di atas. Biarkan dikomentari untuk memakai DB_* saja.
# DATABASE_URL=mysql://root:@127.0.0.1:3306/event_barcode

# --- Aplikasi (opsional) ---
# Alamat & port server. Default 127.0.0.1:3000.
# PORT=3000
# HOST=0.0.0.0
# Set 1 bila dipasang di belakang HTTPS (cookie sesi menjadi Secure).
# COOKIE_SECURE=1
